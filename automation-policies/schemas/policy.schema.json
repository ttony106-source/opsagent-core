{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsagent.dev/schemas/policy.schema.json",
  "title": "OpsAgent Policy Set",
  "type": "object",
  "additionalProperties": false,
  "required": ["policyset_id", "version", "status", "policies"],
  "properties": {
    "policyset_id": {"type": "string", "minLength": 3},
    "version": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"type": "string", "enum": ["draft", "active", "deprecated"]},
    "policies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["policy_id", "action", "mode", "requires", "checks", "evidence_required", "on_deny"],
        "properties": {
          "policy_id": {"type": "string", "minLength": 3},
          "action": {"type": "string", "minLength": 1},
          "mode": {"type": "string", "enum": ["FAIL_CLOSED", "DRY_RUN", "ANY"]},
          "requires": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "authority_role": {"type": "string", "enum": ["CEO", "TRUSTEE"]},
              "payload_fields": {
                "type": "array",
                "items": {"type": "string", "minLength": 1},
                "uniqueItems": true
              }
            }
          },
          "checks": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "evidence_required": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "minItems": 1
          },
          "on_deny": {"type": "string", "enum": ["DENY"]}
        }
      }
    }
  }
}
