{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsagent.dev/schemas/run-log.schema.json",
  "title": "OpsAgent Run Log",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "timestamp",
    "actor",
    "action",
    "mode",
    "payload_hash",
    "decision_hash",
    "hash_prev",
    "hash_curr",
    "decision",
    "evidence"
  ],
  "properties": {
    "run_id": {"type": "string", "pattern": "^[0-9]{6}$"},
    "timestamp": {"type": "string"},
    "actor": {"type": "string", "minLength": 1},
    "action": {"type": "string", "minLength": 1},
    "mode": {"type": "string", "enum": ["FAIL_CLOSED", "DRY_RUN"]},
    "payload_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "decision_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "hash_prev": {"type": "string", "pattern": "^([a-f0-9]{64}|GENESIS)$"},
    "hash_curr": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "decision": {"type": "object"},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": {"path": {"type": "string", "minLength": 1}}
      }
    }
  }
}
