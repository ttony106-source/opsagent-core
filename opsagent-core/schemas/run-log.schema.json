{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsagent.dev/schemas/run-log.schema.json",
  "title": "OpsAgent Run Log",
  "description": "Immutable execution log entry generated by opsagent-core.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "timestamp",
    "actor",
    "action",
    "inputs_hash",
    "outputs_hash",
    "prev_entry_hash",
    "entry_hash",
    "evidence"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9._:-]{8,128}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "inputs_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "outputs_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "prev_entry_hash": {
      "type": "string",
      "pattern": "^([a-f0-9]{64}|GENESIS)$"
    },
    "entry_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "uri", "digest"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["log", "artifact", "attestation", "trace"]
          },
          "uri": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
